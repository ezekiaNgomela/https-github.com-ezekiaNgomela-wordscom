rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidDocumentProcess(data) {
      return data.keys().hasAll(['userId', 'action', 'timestamp', 'originalLength', 'processedLength']) &&
             data.keys().size() == 5 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.action is string && data.action.size() <= 128 &&
             data.timestamp is number &&
             data.originalLength is number &&
             data.processedLength is number;
    }

    function isValidUser(data) {
      return data.keys().hasAny(['isPremium', 'premiumExpires', 'tokens']);
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /users/{userId}/payments/{paymentId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/document_processes/{processId} {
      allow read: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidId(processId) && isValidDocumentProcess(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
